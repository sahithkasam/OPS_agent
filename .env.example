# Copy this file to .env and fill in the values you have.
# Every one of these is optional — the app degrades gracefully without them
# (mock LLM responses, logged-only Slack/Jira calls).

# --- LLM provider (pick one, or leave unset for deterministic mock mode) ---
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Slack ---
SLACK_WEBHOOK_URL=
SLACK_CALLBACK_URL=
SLACK_SIGNING_SECRET=

# --- Jira ---
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# --- Vector DB ---
CHROMA_PATH=./data/chroma_db

# --- Frontend (set at build time, see frontend/.env or your deploy platform) ---
VITE_API_URL=
